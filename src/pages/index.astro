    <!-- Lightbox Modal -->
    <div class="lightbox-modal" id="lightbox">
      <div class="lightbox-inner">
        <button class="lightbox-close" id="lightbox-close" data-i18n-attr="aria-label:modal.closeAria" aria-label={t.modal.closeAria}>&times;</button>
        <img class="lightbox-img-element" id="lightbox-img" src="" alt="Zoomed screenshot" />
        <div class="lightbox-caption" id="lightbox-caption"></div>
      </div>
    </div>

    <!-- Client-Side i18n & Interactive Script -->
    <script is:inline define:vars={{ LOCALES_DATA: LOCALES, DEFAULT_LANG }}>
      document.addEventListener('DOMContentLoaded', () => {
        // --- Lightbox Modal ---
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img');
        const lightboxCaption = document.getElementById('lightbox-caption');
        const lightboxClose = document.getElementById('lightbox-close');

        const triggers = document.querySelectorAll('[data-img]');
        triggers.forEach(trigger => {
          trigger.addEventListener('click', () => {
            const imgSrc = trigger.getAttribute('data-img');
            const caption = trigger.getAttribute('data-caption') || '';
            if (imgSrc) {
              lightboxImg.src = imgSrc;
              lightboxCaption.textContent = caption;
              lightbox.classList.add('active');
            }
          });
        });

        const closeLightbox = () => {
          if (lightbox) lightbox.classList.remove('active');
        };

        if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
        if (lightbox) {
          lightbox.addEventListener('click', (e) => {
            if (e.target === lightbox) closeLightbox();
          });
        }
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && lightbox && lightbox.classList.contains('active')) {
            closeLightbox();
          }
        });

        // --- CastBoard Rotation & Data ---
        const cbItemsSrcs = [
          '/assets/Screenshot_20260719-172822561.jpg',
          '/assets/Screenshot_20260719-172830971.jpg',
          '/assets/Screenshot_20260719-172840770.jpg'
        ];

        let currentCastBoardItems = [];
        let cbCurrentIndex = 0;
        let cbFadeTimeout = null;

        const cbStageImg = document.getElementById('cb-stage-img');
        const cbStageImgBox = document.getElementById('cb-stage-imgbox');
        const cbTitle = document.getElementById('cb-title');
        const cbDesc = document.getElementById('cb-desc');
        const cbDots = document.querySelectorAll('.cb-dot');

        function updateCastBoard(index) {
          if (!currentCastBoardItems || !currentCastBoardItems.length) return;
          cbCurrentIndex = index % currentCastBoardItems.length;
          const item = currentCastBoardItems[cbCurrentIndex];
          if (cbStageImg) {
            if (cbFadeTimeout) clearTimeout(cbFadeTimeout);
            cbStageImg.style.opacity = '0.3';
            cbFadeTimeout = setTimeout(() => {
              cbStageImg.src = item.src;
              cbStageImg.alt = 'CastBoard ' + item.title;
              cbStageImg.style.opacity = '1';
            }, 120);
          }
          if (cbTitle) cbTitle.textContent = item.title;
          if (cbDesc) cbDesc.textContent = item.desc;

          cbDots.forEach((dot, idx) => {
            if (idx === cbCurrentIndex) {
              dot.classList.add('is-active');
            } else {
              dot.classList.remove('is-active');
            }
          });
        }

        if (cbStageImgBox) {
          cbStageImgBox.addEventListener('click', () => {
            updateCastBoard(cbCurrentIndex + 1);
          });
        }

        cbDots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            e.stopPropagation();
            const idx = parseInt(dot.dataset.index, 10);
            if (!isNaN(idx)) {
              updateCastBoard(idx);
            }
          });
        });

        // --- Client-Side i18n Engine ---
        function getNestedValue(obj, path) {
          return path.split('.').reduce((acc, part) => acc && acc[part], obj);
        }

        function applyLanguage(langKey) {
          const normalized = (langKey || '').toLowerCase();
          const currentLoc = LOCALES_DATA[normalized] || LOCALES_DATA[DEFAULT_LANG];
          const t = currentLoc.translations;
          const key = currentLoc.key;

          document.documentElement.lang = currentLoc.code;

          if (t.meta) {
            document.title = t.meta.title;
            const metaDesc = document.querySelector('meta[name="description"]');
            if (metaDesc) metaDesc.setAttribute('content', t.meta.description);
          }

          document.querySelectorAll('[data-i18n]').forEach((el) => {
            const path = el.getAttribute('data-i18n');
            const val = getNestedValue(t, path);
            if (val !== undefined && val !== null) {
              el.textContent = val;
            }
          });

          document.querySelectorAll('[data-i18n-attr]').forEach((el) => {
            const spec = el.getAttribute('data-i18n-attr');
            const [attrName, path] = spec.split(':');
            const val = getNestedValue(t, path);
            if (attrName && val) {
              el.setAttribute(attrName, val);
            }
          });

          const langLabel = document.getElementById('current-lang-name');
          if (langLabel) langLabel.textContent = currentLoc.name;

          document.querySelectorAll('.lang-option').forEach((opt) => {
            if (opt.getAttribute('data-lang') === key) {
              opt.classList.add('is-active');
            } else {
              opt.classList.remove('is-active');
            }
          });

          // Sync CastBoard translations & update UI
          if (t.castboard && t.castboard.items) {
            currentCastBoardItems = t.castboard.items.map((item, idx) => ({
              src: cbItemsSrcs[idx],
              title: item.title,
              desc: item.desc
            }));
            updateCastBoard(cbCurrentIndex);
          }

          try {
            localStorage.setItem('colink_lang', key);
          } catch (e) {}
        }

        // Dropdown toggle on click
        const langBtn = document.getElementById('lang-btn');
        const langDropdown = document.getElementById('lang-dropdown');
        const langSelector = document.querySelector('.lang-selector');

        if (langBtn && langDropdown) {
          langBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            langDropdown.classList.toggle('is-open');
          });

          document.addEventListener('click', (e) => {
            if (langSelector && !langSelector.contains(e.target)) {
              langDropdown.classList.remove('is-open');
            }
          });
        }

        // Dropdown option handlers
        document.querySelectorAll('.lang-option').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const lang = btn.getAttribute('data-lang');
            applyLanguage(lang);
            if (langDropdown) langDropdown.classList.remove('is-open');
          });
        });

        // 语言判定逻辑：1. 用户选择语言 -> 2. 用户浏览器语言 -> 3. Fallback 英文
        function detectBrowserLanguage() {
          const navLangs = navigator.languages || [navigator.language || ''];
          for (const l of navLangs) {
            if (!l) continue;
            const lower = l.toLowerCase();
            if (lower.startsWith('zh-tw') || lower.startsWith('zh-hk') || lower.startsWith('zh-mo') || lower.includes('hant')) return 'zh-tw';
            if (lower.startsWith('zh')) return 'zh-cn';
            if (lower.startsWith('en')) return 'en';
            if (lower.startsWith('ja')) return 'ja';
            if (lower.startsWith('ko')) return 'ko';
            if (lower.startsWith('de')) return 'de';
            if (lower.startsWith('es')) return 'es';
            if (lower.startsWith('ru')) return 'ru';
          }
          return null;
        }

        let initialLang = null;
        try {
          const saved = localStorage.getItem('colink_lang');
          if (saved && LOCALES_DATA[saved]) {
            initialLang = saved; // 1. 用户选择的语言
          }
        } catch (e) {}

        if (!initialLang) {
          initialLang = detectBrowserLanguage(); // 2. 没选择 -> 用户浏览器语言
        }

        if (!initialLang || !LOCALES_DATA[initialLang]) {
          initialLang = 'en'; // 3. Fallback -> 英文
        }

        applyLanguage(initialLang);
      });
    </script>
  </body>
</html>
