---
import ProtocolLink from "../components/ProtocolLink.jsx";
import "../styles/global.css";
import { LOCALES, DEFAULT_LOCALE, getLocale } from "../i18n/index.js";

const defaultLoc = getLocale(DEFAULT_LOCALE);
const t = defaultLoc.translations;
const DEFAULT_LANG = DEFAULT_LOCALE;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#f7f7f5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" as="image" href="/assets/Screenshot_20260719-172830971.jpg" />
    <link rel="preload" as="image" href="/assets/Screenshot_20260719-172840770.jpg" />
    <title>{t.meta.title}</title>
  </head>
  <body>
    <main>
      <!-- Top Hero Section -->
      <section class="entry" aria-labelledby="site-title">
        <a class="brand" href="/" aria-label="CoLink home">
          <svg class="mark" viewBox="48 44 393 393" aria-hidden="true">
            <path d="M420.523 214.076A182 182 0 1 0 218.076 416.523A32 32 0 0 0 220.172 352.557A118 118 0 1 1 356.557 216.172A32 32 0 0 0 420.523 214.076Z" />
            <circle cx="346.07" cy="342.07" r="85" />
          </svg>
          <span class="brand-label">CoLink</span>
        </a>

        <div class="content">
          <p class="eyebrow" data-i18n="hero.eyebrow">{t.hero.eyebrow}</p>
          <h1 id="site-title">{t.hero.title}</h1>
          
          <!-- Hero Actions: Start + Download + Explore Protocol -->
          <div class="hero-actions">
            <a class="btn-start" href="#overview" id="start-btn">
              <span data-i18n="hero.start">{t.hero.start}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 5v14M5 12l7 7 7-7" />
              </svg>
            </a>
            <a class="btn-download" href="#download">
              <span data-i18n="hero.download">{t.hero.download}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 3v10m-4-4l4 4 4-4M5 20h14" />
              </svg>
            </a>
            <ProtocolLink href="/CoLinkProtocol/" label={t.hero.exploreProtocol} />
          </div>
        </div>
      </section>

      <!-- Sticky Quick Navigation Bar -->
      <nav class="sticky-nav" aria-label="Quick Navigation">
        <a class="nav-brand" href="#">
          <svg class="mark" viewBox="48 44 393 393" width="20" height="20" aria-hidden="true">
            <path d="M420.523 214.076A182 182 0 1 0 218.076 416.523A32 32 0 0 0 220.172 352.557A118 118 0 1 1 356.557 216.172A32 32 0 0 0 420.523 214.076Z" />
            <circle cx="346.07" cy="342.07" r="85" />
          </svg>
          <span>CoLink</span>
        </a>
        <ul class="nav-links">
          <li><a href="#overview" data-i18n="nav.features">{t.nav.features}</a></li>
          <li><a href="#castboard" data-i18n="nav.castboard">{t.nav.castboard}</a></li>
          <li><a href="#security" data-i18n="nav.security">{t.nav.security}</a></li>
          <li><a href="#download" data-i18n="nav.download">{t.nav.download}</a></li>
        </ul>
        <div class="nav-right-actions">
          <div class="lang-selector">
            <button class="lang-btn" type="button" aria-label="Select Language" id="lang-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M2 12h20"></path>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
              <span id="current-lang-name">{defaultLoc.name}</span>
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9l6 6 6-6"></path>
              </svg>
            </button>
            <div class="lang-dropdown" id="lang-dropdown">
              {Object.entries(LOCALES).map(([key, loc]) => (
                <button type="button" class={`lang-option ${key === DEFAULT_LOCALE ? 'is-active' : ''}`} data-lang={key}>
                  <span>{loc.name}</span>
                </button>
              ))}
            </div>
          </div>
          <a class="nav-gh-btn" href="https://github.com/CoLinkDev/CoLink" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span data-i18n="nav.github">{t.nav.github}</span>
          </a>
        </div>
      </nav>

      <!-- Section 1: 核心功能 -->
      <section id="overview" class="section-wrapper">
        <div class="section-header">
          <span class="section-badge" data-i18n="features.badge">{t.features.badge}</span>
          <h2 class="section-heading" data-i18n="features.heading">{t.features.heading}</h2>
          <p class="section-desc" data-i18n="features.desc">{t.features.desc}</p>
        </div>

        <div class="feature-grid feature-grid-9">
          <!-- Card 1 -->
          <div class="feature-card">
            <div class="feature-icon-box">
              <svg viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
            </div>
            <h3 class="feature-title" data-i18n="features.card1Title">{t.features.card1Title}</h3>
            <p data-i18n="features.card1Desc">{t.features.card1Desc}</p>
          </div>

          <!-- Card 2 -->
          <div class="feature-card">
            <div class="feature-icon-box">
              <svg viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <h3 class="feature-title" data-i18n="features.card2Title">{t.features.card2Title}</h3>
            <p data-i18n="features.card2Desc">{t.features.card2Desc}</p>
          </div>

          <!-- Card 3 -->
          <div class="feature-card">
            <div class="feature-icon-box">
              <svg viewBox="0 0 24 24"><path d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
            </div>
            <h3 class="feature-title" data-i18n="features.card3Title">{t.features.card3Title}</h3>
            <p data-i18n="features.card3Desc">{t.features.card3Desc}</p>
          </div>

          <!-- Card 4 -->
          <div class="feature-card">
            <div class="feature-icon-box">
              <svg viewBox="0 0 24 24"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
            </div>
            <h3 class="feature-title" data-i18n="features.card4Title">{t.features.card4Title}</h3>
            <p data-i18n="features.card4Desc">{t.features.card4Desc}</p>
          </div>

          <!-- Card 5 -->
          <div class="feature-card">
            <div class="feature-icon-box">
              <svg viewBox="0 0 24 24"><path d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
            <h3 class="feature-title" data-i18n="features.card5Title">{t.features.card5Title}</h3>
            <p data-i18n="features.card5Desc">{t.features.card5Desc}</p>
          </div>

          <!-- Card 6 -->
          <div class="feature-card">
            <div class="feature-icon-box">
              <svg viewBox="0 0 24 24"><path d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            </div>
            <h3 class="feature-title" data-i18n="features.card6Title">{t.features.card6Title}</h3>
            <p data-i18n="features.card6Desc">{t.features.card6Desc}</p>
          </div>

          <!-- Card 7 -->
          <div class="feature-card">
            <div class="feature-icon-box">
              <svg viewBox="0 0 24 24"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            </div>
            <h3 class="feature-title" data-i18n="features.card7Title">{t.features.card7Title}</h3>
            <p data-i18n="features.card7Desc">{t.features.card7Desc}</p>
          </div>

          <!-- Card 8 -->
          <div class="feature-card">
            <div class="feature-icon-box">
              <svg viewBox="0 0 24 24"><path d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <h3 class="feature-title" data-i18n="features.card8Title">{t.features.card8Title}</h3>
            <p data-i18n="features.card8Desc">{t.features.card8Desc}</p>
          </div>

          <!-- Card 9 -->
          <div class="feature-card">
            <div class="feature-icon-box">
              <svg viewBox="0 0 24 24"><path d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>
            </div>
            <h3 class="feature-title" data-i18n="features.card9Title">{t.features.card9Title}</h3>
            <p data-i18n="features.card9Desc">{t.features.card9Desc}</p>
          </div>
        </div>
      </section>

      <!-- Section 2: CastBoard -->
      <section id="castboard" class="section-wrapper castboard-wrapper">
        <div class="cb-header-box">
          <span class="section-badge" data-i18n="castboard.badge">{t.castboard.badge}</span>
          <h2 class="section-heading cb-main-heading" data-i18n="castboard.heading">{t.castboard.heading}</h2>
        </div>

        <div class="cb-viewer">
          <!-- Left: image container -->
          <div class="cb-stage-container">
            <div
              class="cb-stage-img-box"
              id="cb-stage-imgbox"
              data-i18n-attr="title:castboard.switchHint"
              title={t.castboard.switchHint}
            >
              <img
                class="cb-stage-img"
                id="cb-stage-img"
                src="/assets/Screenshot_20260719-172822561.jpg"
                alt={t.castboard.items[0].alt}
              />
            </div>
          </div>

          <!-- Right: content box -->
          <div class="cb-right">
            <div class="cb-content-box">
              <h3 class="cb-item-title" id="cb-title">{t.castboard.items[0].title}</h3>
              <p class="cb-item-desc" id="cb-desc">{t.castboard.items[0].desc}</p>
            </div>

            <div class="cb-dots" id="cb-dots">
              {t.castboard.items.map((item, index) => (
                <button
                  type="button"
                  class={`cb-dot ${index === 0 ? 'is-active' : ''}`}
                  data-index={index}
                  aria-label={item.ariaLabel}
                ></button>
              ))}
            </div>

            <div class="cb-actions">
              <a class="btn-yt-demo" href="https://www.youtube.com/watch?v=w7pMdKMIfjg" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                <span data-i18n="castboard.videoDemo">{t.castboard.videoDemo}</span>
              </a>
            </div>

            <!-- Visual switch hint -->
            <div class="cb-switch-hint">
              <svg class="cb-dashed-line" viewBox="0 0 84 27" fill="none">
                <path d="M84 13.5H12" stroke="#26bc75" stroke-width="3.5" stroke-dasharray="7 4"/>
                <path d="M18 4.5L4.5 13.5l13.5 9" stroke="#26bc75" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="cb-hint-text" data-i18n="castboard.switchHint">{t.castboard.switchHint}</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: 安全 -->
      <section id="security" class="section-wrapper">
        <div class="section-header">
          <span class="section-badge" data-i18n="security.badge">{t.security.badge}</span>
          <h2 class="section-heading" data-i18n="security.heading">{t.security.heading}</h2>
          <p class="section-desc" data-i18n="security.desc">{t.security.desc}</p>
        </div>

        <div class="sec-specs-grid">
          <div class="spec-item">
            <div class="spec-icon">
              <svg viewBox="0 0 24 24"><path d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
            </div>
            <div class="spec-content">
              <h4 data-i18n="security.spec1Title">{t.security.spec1Title}</h4>
              <p data-i18n="security.spec1Desc">{t.security.spec1Desc}</p>
            </div>
          </div>

          <div class="spec-item">
            <div class="spec-icon">
              <svg viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <div class="spec-content">
              <h4 data-i18n="security.spec2Title">{t.security.spec2Title}</h4>
              <p data-i18n="security.spec2Desc">{t.security.spec2Desc}</p>
            </div>
          </div>

          <div class="spec-item">
            <div class="spec-icon">
              <svg viewBox="0 0 24 24"><path d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"/></svg>
            </div>
            <div class="spec-content">
              <h4 data-i18n="security.spec3Title">{t.security.spec3Title}</h4>
              <p data-i18n="security.spec3Desc">{t.security.spec3Desc}</p>
            </div>
          </div>

          <div class="spec-item">
            <div class="spec-icon">
              <svg viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div class="spec-content">
              <h4 data-i18n="security.spec4Title">{t.security.spec4Title}</h4>
              <p data-i18n="security.spec4Desc">{t.security.spec4Desc}</p>
            </div>
          </div>

          <div class="spec-item">
            <div class="spec-icon">
              <svg viewBox="0 0 24 24"><path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
            </div>
            <div class="spec-content">
              <h4 data-i18n="security.spec5Title">{t.security.spec5Title}</h4>
              <p data-i18n="security.spec5Desc">{t.security.spec5Desc}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: 下载 -->
      <section id="download" class="section-wrapper">
        <div class="section-header">
          <span class="section-badge" data-i18n="download.badge">{t.download.badge}</span>
          <h2 class="section-heading" data-i18n="download.heading">{t.download.heading}</h2>
          <p class="section-desc" data-i18n="download.desc">{t.download.desc}</p>
        </div>

        <div class="download-cards-grid">
          <!-- Windows -->
          <div class="dl-card">
            <div class="dl-header">
              <div class="dl-platform-icon">
                <svg viewBox="0 0 24 24"><path d="M0 3.449L9.75 2.1v9.451H0V3.449zM0 12.45h9.75v9.45L0 20.551v-8.101zM10.95 1.936L24 0v11.55H10.95V1.936zM24 12.45v11.55l-13.05-1.936V12.45H24z"/></svg>
              </div>
            </div>
            <h3 data-i18n="download.winTitle">{t.download.winTitle}</h3>
            <p data-i18n="download.winDesc">{t.download.winDesc}</p>
            <a class="dl-btn" href="https://github.com/CoLinkDev/colink-desktop/releases/latest" target="_blank" rel="noopener noreferrer">
              <span data-i18n="download.winBtn">{t.download.winBtn}</span>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
            </a>
          </div>

          <!-- Android -->
          <div class="dl-card">
            <div class="dl-header">
              <div class="dl-platform-icon">
                <svg viewBox="0 0 24 24"><path d="M17.523 8.7l1.816-3.146a.5.5 0 10-.866-.5L16.64 8.229a10.94 10.94 0 00-9.282 0L5.53 5.054a.5.5 0 00-.866.5L6.48 8.7A10.942 10.942 0 001 18h22a10.942 10.942 0 00-5.477-9.3zM7 15a1 1 0 110-2 1 1 0 010 2zm10 0a1 1 0 110-2 1 1 0 010 2z"/></svg>
              </div>
            </div>
            <h3 data-i18n="download.androidTitle">{t.download.androidTitle}</h3>
            <p data-i18n="download.androidDesc">{t.download.androidDesc}</p>
            <a class="dl-btn" href="https://github.com/CoLinkDev/colink-android/releases/latest" target="_blank" rel="noopener noreferrer">
              <span data-i18n="download.androidBtn">{t.download.androidBtn}</span>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
            </a>
          </div>

          <!-- Linux -->
          <div class="dl-card">
            <div class="dl-header">
              <div class="dl-platform-icon">
                <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0012 2z"/></svg>
              </div>
            </div>
            <h3 data-i18n="download.linuxTitle">{t.download.linuxTitle}</h3>
            <p data-i18n="download.linuxDesc">{t.download.linuxDesc}</p>
            <a class="dl-btn" href="https://github.com/CoLinkDev/colink-desktop/releases/latest" target="_blank" rel="noopener noreferrer">
              <span data-i18n="download.linuxBtn">{t.download.linuxBtn}</span>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
            </a>
          </div>

          <!-- Docker -->
          <div class="dl-card">
            <div class="dl-header">
              <div class="dl-platform-icon">
                <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 01.45.11l8 4A1 1 0 0121 7v10a1 1 0 01-.55.89l-8 4a1 1 0 01-.9 0l-8-4A1 1 0 013 17V7a1 1 0 01.55-.89l8-4A1 1 0 0112 2zm0 2.24L6.2 7 12 9.76 17.8 7 12 4.24zM5 8.76V16.5l6 3V11.5L5 8.76zm14 0L13 11.5v8l6-3V8.76z"/></svg>
              </div>
