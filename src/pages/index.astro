---
import ProtocolLink from "../components/ProtocolLink.jsx";
import "../styles/global.css";

const title = "CoLink";
const description = "CoLink connects your devices, services, and protocols.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <section class="entry" aria-labelledby="site-title">
        <a class="brand" href="/" aria-label="CoLink home">
          <svg class="mark" viewBox="48 44 393 393" aria-hidden="true">
            <path d="M420.523 214.076A182 182 0 1 0 218.076 416.523A32 32 0 0 0 220.172 352.557A118 118 0 1 1 356.557 216.172A32 32 0 0 0 420.523 214.076Z" />
            <circle cx="346.07" cy="342.07" r="85" />
          </svg>
          <span class="brand-label">CoLink</span>
        </a>

        <div class="content">
          <p class="eyebrow">CONNECT ALL YOUR DEVICES FOR SEAMLESS COLLABORATION.</p>
          <h1 id="site-title">CoLink</h1>
          <ProtocolLink href="/CoLinkProtocol/" label="Explore Protocol" />
        </div>
      </section>
    </main>
  </body>
</html>
